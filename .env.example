# D4EXAM Android app — PUBLIC client env only (safe in the APK)
# Never put SERVICE_ROLE, RESEND, or YouTube server keys here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Optional aliases some code paths still read
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_ref

# Firebase client config for FCM (public) — not the service account JSON
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=d4exam-6506a
