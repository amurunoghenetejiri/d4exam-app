# Public (safe in browser) — Vercel / Lovable env
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key

# Server only — never expose to the browser
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Canonical public origin (emails, auth redirects, push deep links)
APP_URL=https://d4exam.name.ng
PUBLIC_APP_URL=https://d4exam.name.ng

# Resend (server only — never VITE_)
RESEND_API_KEY=
RESEND_FROM=D4EXAM <noreply@d4exam.name.ng>
EMAIL_FROM=D4EXAM <noreply@d4exam.name.ng>

# Firebase Cloud Messaging HTTP v1 (server)
# Paste the full service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=d4exam-6506a

# Legacy FCM only if Cloud Messaging API (Legacy) is enabled
# FCM_SERVER_KEY=

# YouTube Data API v3 (server only — Study Help for students)
# Never prefix with VITE_ — must not ship to the browser
YOUTUBE_API_KEY=
